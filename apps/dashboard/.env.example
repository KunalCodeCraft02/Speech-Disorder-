# Gateway REST base (services/gateway, mounted at /api/v1)
VITE_API_URL=http://localhost:4000/api/v1

# Gateway Socket.IO origin (the /dashboard namespace is appended automatically)
VITE_SOCKET_URL=http://localhost:4000

# Run against an in-browser simulated metrics stream instead of the real
# gateway/DSP stack — useful for UI development or a live demo without
# Mongo/Redis/FastAPI running. Set to "false" to use the real backend.
VITE_DEMO_MODE=true
