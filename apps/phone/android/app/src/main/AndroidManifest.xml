<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Item 7: keeps mic capture + DSP + classification + alerts
             running while the app is backgrounded/screen-locked -- see
             RecordingForegroundService.java's doc comment. Must declare
             foregroundServiceType="microphone" (Android 14/targetSdk 34+
             throws at startForeground() otherwise) and stay a private,
             non-exported component (only this app's own JS, via
             RecordingServicePlugin, ever starts/stops it). -->
        <service
            android:name=".RecordingForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <!-- getUserMedia() in the WebView needs both this manifest permission
         AND the runtime grant requested in MainActivity.java, AND the
         WebChromeClient override that answers the WebView's own internal
         permission prompt (onPermissionRequest) - all three are required
         for mic capture to work inside a Capacitor WebView. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <!-- Chromium's Android audio backend (media/audio/android/audio_manager_android.cc)
         calls AudioManager.setMode()/selects a communication device for
         *every* getUserMedia audio capture, regardless of constraints,
         confirmed via `adb logcat` showing "Unable to select communication
         device!" on every attempt. That AudioManager call requires this
         permission; without it declared, mic capture fails outright with
         NotReadableError even though RECORD_AUDIO is granted. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Item 7: background operation. FOREGROUND_SERVICE is required on
         Android 9+ to start any foreground service at all;
         FOREGROUND_SERVICE_MICROPHONE is the type-specific grant Android
         14+ additionally requires for a foreground service that holds the
         microphone (RecordingForegroundService.java); POST_NOTIFICATIONS
         is the Android 13+ runtime permission needed to actually show that
         service's persistent notification (requested in MainActivity.java). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No server calls are made after first install (the app is fully
         offline-first), but Capacitor's WebView plumbing and the
         precached service worker still expect this present by default. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
