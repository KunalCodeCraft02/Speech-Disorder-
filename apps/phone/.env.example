# Gateway REST base (services/gateway, mounted at /api/v1)
VITE_API_URL=http://localhost:4000/api/v1

# Gateway Socket.IO origin — the /device and /dashboard namespaces are
# appended automatically.
VITE_SOCKET_URL=http://localhost:4000

# Run against an in-browser simulated device/dashboard socket instead of
# the real gateway/DSP stack — lets you test the record/vibrate flow
# without Mongo/Redis/FastAPI running. Set to "false" for the real backend.
VITE_DEMO_MODE=true
