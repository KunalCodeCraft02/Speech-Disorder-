# --- Server ---
NODE_ENV=development
PORT=4000

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/speech_biofeedback

# --- JWT ---
# Generate strong secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-secret
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Comma-separated list of allowed origins, or "*" for all (not recommended in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- FastAPI DSP service ---
FASTAPI_WS_URL=ws://localhost:8000
FASTAPI_REST_URL=http://localhost:8000
FASTAPI_SERVICE_TOKEN=
DSP_CONNECT_TIMEOUT_MS=5000
DSP_MAX_RECONNECT_ATTEMPTS=10
DSP_RECONNECT_BASE_DELAY_MS=1000
DSP_RECONNECT_MAX_DELAY_MS=8000

# --- Redis (optional — required only when running more than one gateway instance) ---
REDIS_URL=

# --- Logging ---
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Body size ---
# 5mb to fit a base64-encoded ~30s calibration recording (POST
# /users/:id/calibration/record) comfortably above its ~1.3MB payload.
BODY_LIMIT=5mb
