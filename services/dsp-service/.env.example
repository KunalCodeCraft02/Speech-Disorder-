ENV=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

# Shared secret the gateway sends as `Authorization: Bearer <token>`.
# Leave empty in development. Must be set (and match FASTAPI_SERVICE_TOKEN
# in the gateway's .env) in production.
DSP_SERVICE_TOKEN=

SAMPLE_RATE=16000

# Rolling window driving the live rate features / classification
ANALYSIS_WINDOW_SEC=4.0
MIN_EMIT_INTERVAL_SEC=0.5
WARMUP_SEC=1.0

# Hysteresis before confirming a Tachylalia/Bradylalia state change
HYSTERESIS_WINDOWS=3
FEEDBACK_REFRACTORY_SEC=4.0

# Population defaults used when a session has no calibrated Profile
DEFAULT_BASELINE_ARTICULATION_RATE=4.4
DEFAULT_BASELINE_PAUSE_RATIO=0.2
TACHYLALIA_MULTIPLIER=1.35
BRADYLALIA_MULTIPLIER=0.65

CORS_ORIGINS=*
